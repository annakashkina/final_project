# Any OpenAI-compatible provider (Groq, xAI, OpenAI, Ollama, etc.)
LLM_API_KEY=sk-your-api-key-here
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=llama-3.3-70b-versatile

# Optional fallback used when the primary returns 429.
# Only LLM_FALLBACK_API_KEY is required to enable it; URL/MODEL default to the primary's.
#LLM_FALLBACK_API_KEY=sk-your-fallback-key
#LLM_FALLBACK_API_URL=https://api.groq.com/openai/v1/chat/completions
#LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

DASHBOARD_SECRET=our-dashboard-secret